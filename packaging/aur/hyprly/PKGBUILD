pkgname=hyprly
pkgver=0.9
pkgrel=1
pkgdesc='Headless AI meeting assistant with a mobile client'
arch=('x86_64')
url='https://github.com/patermars/Hyprly'
license=('MIT')
depends=('pipewire' 'wireplumber')
optdepends=('poppler: PDF upload support'
            'unzip: DOCX upload support')
source=("hyprly-${pkgver}-x86_64-linux.tar.gz::${url}/releases/download/v${pkgver}/hyprly-v${pkgver}-x86_64-linux.tar.gz")
sha256sums=('733553360e82f45bda7f131bd4d34bf815fc46f8bb890bd07f2b2734442b5b9c')

package() {
    install -Dm755 "$srcdir/hyprly" "$pkgdir/usr/bin/hyprly"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/config.example.toml" "$pkgdir/usr/share/doc/$pkgname/config.example.toml"
    install -Dm644 "$srcdir"/assets/icons/*.svg -t "$pkgdir/usr/share/hyprly/icons"
    install -Dm644 "$srcdir/assets/icons/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LUCIDE-LICENSE"
}
